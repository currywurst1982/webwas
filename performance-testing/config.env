# ============================================================
# 성능테스트 환경 설정 파일
# run-load-test.sh, pre-test-check.sh 에서 자동으로 로드됩니다.
# ============================================================

# ── 대상 서버 ────────────────────────────────────────────────
BASE_URL="http://43.203.161.30:8080"
APP_CONTEXT=""

# ── WildFly 설치 경로 ────────────────────────────────────────
JBOSS_HOME="/opt/wildfly-26"
JAVA_HOME="/usr/lib/jvm/java-1.8.0"

# ── Gatling 설치 경로 ────────────────────────────────────────
GATLING_HOME="/opt/gatling-charts-highcharts-bundle-3.10.5"
# Gatling 3.x는 Java 11 이상 필수 (WildFly용 Java 8과 분리)
# 설치: sudo amazon-linux-extras install java-openjdk11 -y
GATLING_JAVA_HOME="/usr/lib/jvm/java-11-openjdk"
#JMETER_HOME="/opt/jmeter"

# ── WildFly Management API ───────────────────────────────────
WILDFLY_MGMT_HOST="43.203.161.30"
WILDFLY_MGMT_PORT="9990"
WILDFLY_MGMT_USER="admin"
WILDFLY_MGMT_PASS="admin"

# ── 모니터링 대상 Datasource 이름 ────────────────────────────
WILDFLY_DS_NAMES="claude"

# ── OS 장치명 ────────────────────────────────────────────────
NET_IFACE="eth0"
DISK_DEV="sda"
