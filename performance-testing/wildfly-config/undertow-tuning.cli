# ============================================================
# WildFly 26 Undertow 서브시스템 성능 튜닝 CLI 스크립트
# 실행: $JBOSS_HOME/bin/jboss-cli.sh --connect --file=undertow-tuning.cli
#
# 튜닝 전략:
#   - IO threads: CPU 코어 수 × 2 (논블로킹 I/O 전담)
#   - Worker threads: CPU 코어 수 × 8~16 (블로킹 작업 처리)
#     (DB 대기, 파일 I/O 등 블로킹 구간이 길수록 더 많이)
# ============================================================

# ── 현재 설정 확인 ──────────────────────────────────────────────────────────
/subsystem=undertow:read-resource(recursive=true)

# ── XNIO Worker 설정 ────────────────────────────────────────────────────────
# io-threads: 논블로킹 I/O 처리 전담 (CPU 코어 수 × 2 권장)
#   → 4코어 서버: io-threads=8
#   → 8코어 서버: io-threads=16
/subsystem=io/worker=default:write-attribute(name=io-threads,value=16)

# task-max-threads: 블로킹 작업 처리 풀 크기
#   → 4코어 서버: 32~64
#   → 8코어 서버: 64~128
#   → DB 쿼리 평균 응답 100ms, 목표 TPS 500이면 최소 50 필요
/subsystem=io/worker=default:write-attribute(name=task-max-threads,value=128)

# ── HTTP Listener 설정 ──────────────────────────────────────────────────────
# max-connections: 동시 최대 HTTP 연결 수
#   → 미설정 시 무제한 (Worker thread 고갈 방지를 위해 명시 권장)
/subsystem=undertow/server=default-server/http-listener=default:\
  write-attribute(name=max-connections,value=1000)

# read-timeout: 클라이언트가 요청을 보내는 최대 시간 (ms)
#   → 너무 짧으면 업로드/대용량 요청 실패, 너무 길면 idle 연결 점유
/subsystem=undertow/server=default-server/http-listener=default:\
  write-attribute(name=read-timeout,value=30000)

# request-parse-timeout: 요청 파싱 최대 시간 (ms)
/subsystem=undertow/server=default-server/http-listener=default:\
  write-attribute(name=request-parse-timeout,value=10000)

# max-post-size: 허용 최대 POST 본문 크기 (바이트)
#   → 10MB = 10485760
/subsystem=undertow/server=default-server/http-listener=default:\
  write-attribute(name=max-post-size,value=10485760)

# max-parameters: 요청 파라미터 최대 개수 (DoS 방지)
/subsystem=undertow/server=default-server/http-listener=default:\
  write-attribute(name=max-parameters,value=1000)

# max-headers: 요청 헤더 최대 개수
/subsystem=undertow/server=default-server/http-listener=default:\
  write-attribute(name=max-headers,value=200)

# buffer-pipelined-data: 파이프라인 데이터 버퍼 활성화
/subsystem=undertow/server=default-server/http-listener=default:\
  write-attribute(name=buffer-pipelined-data,value=true)

# enable-http2: HTTP/2 활성화 (SSL 설정된 경우)
# /subsystem=undertow/server=default-server/https-listener=https:\
#   write-attribute(name=enable-http2,value=true)

# ── 버퍼 풀 설정 ─────────────────────────────────────────────────────────────
# buffer-size: 각 버퍼 크기 (bytes) - 일반적으로 16384 (16KB) 권장
/subsystem=io/buffer-pool=default:write-attribute(name=buffer-size,value=16384)

# buffers-per-region: 리전당 버퍼 수 (전체 메모리 = buffer-size × buffers-per-region × regions)
/subsystem=io/buffer-pool=default:write-attribute(name=buffers-per-region,value=20)

# direct-buffers: JVM 힙 외부 DirectMemory 사용 (GC 압력 감소)
/subsystem=io/buffer-pool=default:write-attribute(name=direct-buffers,value=true)

# ── Access Log 설정 (성능테스트 중 응답시간 포함) ────────────────────────────
# %D: 요청 처리 시간(ms), 성능 분석 필수
/subsystem=undertow/server=default-server/host=default-host/\
  setting=access-log:add(pattern="%h %l %u %t \"%r\" %s %b %D")

# ── 통계 활성화 (WildFly CLI로 런타임 조회용) ────────────────────────────────
/subsystem=undertow/server=default-server/http-listener=default:\
  write-attribute(name=statistics-enabled,value=true)

# ── 변경사항 적용 (런타임 재로드) ────────────────────────────────────────────
:reload

# ── 적용 후 확인 ─────────────────────────────────────────────────────────────
/subsystem=io/worker=default:read-resource(include-runtime=true)
/subsystem=undertow/server=default-server/http-listener=default:read-resource(include-runtime=true)
